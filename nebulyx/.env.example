# ---- MeRa Poly runner configuration (all optional) ----

# auto  = use local compilers if available (dev only by default), otherwise cloud
# local = only use compilers installed on this machine
# cloud = always use the Judge0 cloud runner
MERAPOLY_RUNNER=auto

# Local execution runs real programs on the machine hosting the app.
# It is ON by default for `npm run dev` and OFF for production builds.
# Set to "true" only on a machine you fully trust / sandbox.
# MERAPOLY_LOCAL_RUNNER=true

# Cloud runner (Judge0 CE). Default is the free public instance.
# JUDGE0_URL=https://ce.judge0.com
# JUDGE0_API_KEY=
